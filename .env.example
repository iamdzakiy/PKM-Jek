# ── Supabase ────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Settings → API → service_role — server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Database (Prisma) ───────────────────────────────────────────────────
# Settings → Database → Connection string → "Transaction" pooler (port 6543)
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Settings → Database → Connection string → "Session" / direct (port 5432) — used only for migrations
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Privacy gate ────────────────────────────────────────────────────────
# The ONLY email allowed to sign in. Everyone else is rejected in middleware.ts
# even if they somehow obtain a valid Supabase session.
ALLOWED_EMAIL=akbarussadatprof@gmail.com

# Base URL of this app — used as the magic-link redirect target.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cron ────────────────────────────────────────────────────────────────
# Shared secret required by /api/recompute-scores (called by Vercel Cron or
# any scheduler) to recompute Memory Buoyancy / Preservation Value nightly.
CRON_SECRET=change-me-to-a-long-random-string
