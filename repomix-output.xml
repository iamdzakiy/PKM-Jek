import { revalidatePath } from 'next/cache';
import { prisma } from '@/lib/prisma';
import { requireUser } from '@/lib/current-user';
import type { TaskStatus } from '@prisma/client';

/**
 * "Benign friction" capture: when the user types a vague task, we still
 * require an explicit spatiotemporal negotiation (dueAt / location) before
 * it's saved — a small, deliberate confirmation step rather than silently
 * autopiloting a guess, per the Kairotask pattern in the research doc.
 */
export async function createTask(formData: FormData) {
  const user = await requireUser();
  const title = String(formData.get('title') ?? '').trim();
  const dueAt = String(formData.get('dueAt') ?? '');
  const location = String(formData.get('location') ?? '').trim() || null;
  const projectId = String(formData.get('projectId') ?? '') || null;
  if (!title) throw new Error('Judul tugas wajib diisi.');

  await prisma.task.create({
    data: {
      userId: user.id,
      title,
      projectId,
      location,
      dueAt: dueAt ? new Date(dueAt) : null,
    },
  });
  revalidatePath('/tasks');
  revalidatePath('/');
}

export async function setTaskStatus(taskId: string, status: TaskStatus) {
  const user = await requireUser();
  await prisma.task.updateMany({ where: { id: taskId, userId: user.id }, data: { status } });
  revalidatePath('/tasks');
  revalidatePath('/');
}
