import { notFound } from 'next/navigation';
import { Trash2, BrainCircuit } from 'lucide-react';
import { prisma } from '@/lib/prisma';
import { requireUser } from '@/lib/current-user';
import { updateNote, deleteNote } from '@/app/actions/notes';
import { scheduleRecall } from '@/app/actions/recall';
import { TopBar } from '@/components/pkm/topbar';
import { ScorePill } from '@/components/pkm/score-pill';
import { Card, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input, Label, Textarea } from '@/components/ui/input';
import { Badge } from '@/components/ui/badge';
import { formatRelative } from '@/lib/utils';

export const dynamic = 'force-dynamic';

export default async function NoteDetailPage({ params }: { params: { id: string } }) {
  const user = await requireUser();
  const note = await prisma.note.findFirst({
    where: { id: params.id, userId: user.id },
    include: {
      topics: { include: { topic: true } },
      memoryScore: true,
      recallSessions: { orderBy: { createdAt: 'desc' } },
      project: true,
    },
  });
  if (!note) notFound();

  // Logging a view is a first-class MB interaction — do it inline since this
  // page load itself is "seeing the note again".
  await prisma.interaction.create({ data: { noteId: note.id, type: 'VIEW', weight: 0.2 } });

  const boundUpdate = updateNote.bind(null, note.id);
  const boundDelete = deleteNote.bind(null, note.id);

  async function boundScheduleRecall(formData: FormData) {
    'use server';
    const question = String(formData.get('question') ?? '').trim();
    const answer = String(formData.get('answer') ?? '').trim();
    if (question && answer) await scheduleRecall(note!.id, question, answer);
  }

  return (
    <>
      <TopBar title="Catatan" email={user.email} />
      <div className="mx-auto w-full max-w-3xl flex-1 space-y-6 p-5">
        <div className="flex items-center justify-between">
          <div className="flex flex-wrap items-center gap-2">
            <Badge tone="accent">{note.type}</Badge>
            {note.project && <Badge tone="neutral">{note.project.name}</Badge>}
            {note.topics.map(({ topic }) => (
              <Badge key={topic.id} tone={topic.isHot ? 'warning' : 'neutral'}>
                #{topic.name}
              </Badge>
            ))}
          </div>
          <form action={boundDelete}>
            <Button variant="ghost" size="sm" type="submit" title="Hapus catatan">
              <Trash2 size={15} className="text-red-500" />
            </Button>
          </form>
        </div>

        {note.memoryScore && (
          <Card className="flex flex-wrap items-center gap-6">
            <ScorePill label="Memory Buoyancy" value={note.memoryScore.memoryBuoyancy} tone="accent" />
            <ScorePill label="Preservation Value" value={note.memoryScore.preservationValue} tone="accent2" />
            <span className="text-xs text-ink-soft">
              Terakhir dihitung {formatRelative(new Date(note.memoryScore.computedAt))}
            </span>
          </Card>
        )}

        <Card>
          <form action={boundUpdate} className="space-y-4">
            <div>
              <Label htmlFor="title">Judul</Label>
              <Input id="title" name="title" defaultValue={note.title} required />
            </div>
            <div>
              <Label htmlFor="content">Isi</Label>
              <Textarea id="content" name="content" defaultValue={note.content} rows={8} />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div>
                <Label htmlFor="quality">Quality (0–1)</Label>
                <Input id="quality" name="quality" type="number" step="0.1" min="0" max="1" defaultValue={note.quality} />
              </div>
              <div>
                <Label htmlFor="coverage">Coverage (0–1)</Label>
                <Input id="coverage" name="coverage" type="number" step="0.1" min="0" max="1" defaultValue={note.coverage} />
              </div>
            </div>
            <Button type="submit">Simpan perubahan</Button>
          </form>
        </Card>

        <Card>
          <div className="mb-3 flex items-center gap-2">
            <BrainCircuit size={16} className="text-accent" />
            <CardTitle>Active Recall</CardTitle>
          </div>
          <form action={boundScheduleRecall} className="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <Input name="question" placeholder="Pertanyaan kuis" required />
            <Input name="answer" placeholder="Jawaban benar" required />
            <div className="sm:col-span-2">
              <Button type="submit" variant="secondary" size="sm">
                Jadwalkan kuis untuk catatan ini
              </Button>
            </div>
          </form>

          {note.recallSessions.length === 0 ? (
            <p className="text-sm text-ink-soft">Belum ada kuis dijadwalkan.</p>
          ) : (
            <ul className="space-y-2">
              {note.recallSessions.map((s) => (
                <li key={s.id} className="flex items-center justify-between rounded-lg bg-bg px-3 py-2 text-sm">
                  <span className="text-ink">{s.question}</span>
                  <Badge tone={s.isCorrect === null ? 'neutral' : s.isCorrect ? 'accent2' : 'danger'}>
                    {s.isCorrect === null ? 'menunggu' : s.isCorrect ? 'benar' : 'salah'}
                  </Badge>
                </li>
              ))}
            </ul>
          )}
        </Card>
      </div>
    </>
  );
}
</file>

