import { Card } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import type { MemoryFolder } from '@prisma/client';

export const dynamic = 'force-dynamic';

async function getBoardData(userId: string) {
  const notes = await prisma.note.findMany({
    where: { userId },
    include: { topics: { include: { topic: true } }, memoryScore: true },
    orderBy: { updatedAt: 'desc' },
  });

  const board: Record<MemoryFolder, typeof notes> = {
    LAST_FOCUS: [],
    HOT_TOPICS: [],
    ACTIVE: [],
    FORGOTTEN: [],
  };
  for (const note of notes) {
    const folder = note.memoryScore?.folder ?? 'ACTIVE';
    board[folder].push(note);
  }
  return board;
}

export default async function DashboardPage() {
  const user = await requireUser();
  const [board, tasks, events] = await Promise.all([
    getBoardData(user.id),
    prisma.task.findMany({
      where: { userId: user.id, status: { not: 'DONE' } },
      orderBy: { dueAt: 'asc' },
      take: 5,
    }),
    prisma.event.findMany({
      where: { userId: user.id, startAt: { gte: new Date() } },
      orderBy: { startAt: 'asc' },
      take: 3,
    }),
  ]);

  const columns: { key: MemoryFolder; icon: typeof Sparkles }[] = [
    { key: 'LAST_FOCUS', icon: Sparkles },
    { key: 'HOT_TOPICS', icon: Flame },
    { key: 'FORGOTTEN', icon: Archive },
