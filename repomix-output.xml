'use client';

import { useState, useTransition } from 'react';
import { submitRecallAnswer } from '@/app/actions/recall';
import { Button } from '@/components/ui/button';
import { Card } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Badge } from '@/components/ui/badge';

interface RecallCardProps {
  sessionId: string;
  question: string;
  correctAnswer: string;
  noteTitle: string;
}

export function RecallCard({ sessionId, question, correctAnswer, noteTitle }: RecallCardProps) {
  const [answer, setAnswer] = useState('');
  const [revealed, setRevealed] = useState(false);
  const [done, setDone] = useState(false);
  const [pending, startTransition] = useTransition();

  if (done) {
    return (
      <Card className="flex items-center justify-between opacity-60">
        <span className="text-sm text-ink">{question}</span>
        <Badge tone="accent2">Terjadwal ulang</Badge>
      </Card>
    );
  }

  function grade(correct: boolean) {
    startTransition(async () => {
      await submitRecallAnswer(sessionId, answer, correct);
      setDone(true);
    });
  }

  return (
    <Card>
      <p className="mb-1 text-xs uppercase tracking-wide text-ink-soft">{noteTitle}</p>
      <p className="mb-3 font-display text-base font-medium text-ink">{question}</p>

      {!revealed ? (
        <div className="space-y-3">
          <Input
            value={answer}
            onChange={(e) => setAnswer(e.target.value)}
            placeholder="Tulis jawabanmu (free recall)…"
          />
          <Button size="sm" onClick={() => setRevealed(true)}>
            Lihat jawaban
          </Button>
        </div>
      ) : (
        <div className="space-y-3">
          <div className="rounded-lg bg-accent-soft/60 px-3 py-2 text-sm text-ink">
            <span className="font-medium">Jawaban benar:</span> {correctAnswer}
          </div>
          {answer && (
            <div className="rounded-lg bg-bg px-3 py-2 text-sm text-ink-soft">
              <span className="font-medium text-ink">Jawabanmu:</span> {answer}
            </div>
          )}
          <div className="flex gap-2">
            <Button size="sm" variant="secondary" disabled={pending} onClick={() => grade(true)}>
              Aku benar
            </Button>
            <Button size="sm" variant="ghost" disabled={pending} onClick={() => grade(false)}>
              Aku salah
            </Button>
          </div>
        </div>
      )}
    </Card>
  );
}
</file>

