              <Card key={key} className="p-0">
                <div className="flex items-center gap-2 border-b border-line px-4 py-3">
                  <Icon size={15} className="text-accent" />
                  <h2 className="text-sm font-semibold text-ink">{FOLDER_LABEL[key]}</h2>
                  <span className="ml-auto text-xs tabular text-ink-soft">{board[key].length}</span>
                </div>
                <div className="max-h-[440px] space-y-3 overflow-y-auto p-3">
                  {board[key].length === 0 ? (
                    <p className="px-1 py-6 text-center text-xs text-ink-soft">Kosong untuk saat ini.</p>
                  ) : (
                    board[key].map((note) => <NoteCard key={note.id} note={note} />)
                  )}
                </div>
              </Card>
            ))}
          </div>

          <div className="space-y-4">
            <Card>
              <div className="mb-3 flex items-center gap-2">
                <ListChecks size={16} className="text-accent" />
                <h2 className="text-sm font-semibold text-ink">Tugas mendatang</h2>
              </div>
              {tasks.length === 0 ? (
                <p className="text-sm text-ink-soft">Tidak ada tugas terbuka.</p>
              ) : (
                <ul className="space-y-2.5">
                  {tasks.map((t) => (
                    <li key={t.id} className="flex items-center justify-between text-sm">
