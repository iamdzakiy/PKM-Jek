import { NotebookText } from 'lucide-react';
import { prisma } from '@/lib/prisma';
import { requireUser } from '@/lib/current-user';
import { createNote } from '@/app/actions/notes';
import { TopBar } from '@/components/pkm/topbar';
import { NoteCard } from '@/components/pkm/note-card';
import { EmptyState } from '@/components/pkm/empty-state';
import { Card } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input, Label, Select, Textarea } from '@/components/ui/input';

export const dynamic = 'force-dynamic';

export default async function NotesPage({ searchParams }: { searchParams: { new?: string } }) {
  const user = await requireUser();
  const [notes, projects] = await Promise.all([
    prisma.note.findMany({
      where: { userId: user.id },
      include: { topics: { include: { topic: true } }, memoryScore: true },
      orderBy: { updatedAt: 'desc' },
    }),
    prisma.project.findMany({ where: { userId: user.id, status: 'ACTIVE' } }),
  ]);

  return (
    <>
      <TopBar title="Catatan" email={user.email} />
      <div className="flex-1 space-y-6 p-5">
        <Card>
          <details open={searchParams.new === '1'}>
            <summary className="cursor-pointer text-sm font-semibold text-ink">+ Tulis catatan baru</summary>
            <form action={createNote} className="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div className="sm:col-span-2">
                <Label htmlFor="title">Judul</Label>
                <Input id="title" name="title" required placeholder="mis. Mekanisme Memory Buoyancy" />
              </div>
              <div className="sm:col-span-2">
                <Label htmlFor="content">Isi</Label>
                <Textarea id="content" name="content" rows={4} placeholder="Tuliskan idenya dengan kata-katamu sendiri…" />
              </div>
              <div>
                <Label htmlFor="type">Tipe</Label>
                <Select id="type" name="type" defaultValue="NOTE">
                  <option value="NOTE">Note</option>
                  <option value="TASK">Task</option>
                  <option value="IDEA">Idea</option>
                  <option value="INSIGHT">Insight</option>
                </Select>
              </div>
              <div>
                <Label htmlFor="projectId">Proyek (opsional)</Label>
                <Select id="projectId" name="projectId" defaultValue="">
                  <option value="">— tanpa proyek —</option>
