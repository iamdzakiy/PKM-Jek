'use client';

import { useFormState, useFormStatus } from 'react-dom';
import { useSearchParams } from 'next/navigation';
import { sendMagicLink, type AuthActionState } from '@/app/actions/auth';
import { Button } from '@/components/ui/button';
import { Input, Label } from '@/components/ui/input';
import { Card } from '@/components/ui/card';

const initialState: AuthActionState = { status: 'idle' };

function SubmitButton() {
  const { pending } = useFormStatus();
  return (
    <Button type="submit" className="w-full" disabled={pending}>
      {pending ? 'Mengirim…' : 'Kirim link masuk'}
    </Button>
  );
}

export default function LoginPage() {
  const [state, formAction] = useFormState(sendMagicLink, initialState);
  const params = useSearchParams();
  const denied = params.get('denied');

  return (
    <main className="flex min-h-screen items-center justify-center px-4">
      <div className="w-full max-w-sm">
        <div className="mb-8 text-center">
          <div className="mx-auto mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-accent text-white font-display text-lg">
            ✺
          </div>
          <h1 className="font-display text-2xl font-semibold text-ink">Second Brain</h1>
          <p className="mt-1 text-sm text-ink-soft">Ruang privat — hanya untuk satu orang.</p>
        </div>

        <Card>
          {denied && (
            <p className="mb-4 rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-600 dark:text-red-400">
              Akun itu tidak diizinkan mengakses aplikasi ini.
            </p>
          )}

          {state.status === 'sent' ? (
            <p className="text-sm text-ink">{state.message}</p>
          ) : (
            <form action={formAction} className="space-y-4">
              <div>
                <Label htmlFor="email">Email</Label>
                <Input id="email" name="email" type="email" placeholder="you@example.com" required autoFocus />
              </div>
              {state.status === 'error' && (
                <p className="text-sm text-red-600 dark:text-red-400">{state.message}</p>
              )}
              <SubmitButton />
            </form>
          )}
        </Card>

        <p className="mt-6 text-center text-xs text-ink-soft">
          Akses dibatasi ke satu alamat email yang terdaftar di server.
        </p>
      </div>
    </main>
  );
}
