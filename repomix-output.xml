'use server';

import { revalidatePath } from 'next/cache';
import { redirect } from 'next/navigation';
import { prisma } from '@/lib/prisma';
import { requireUser } from '@/lib/current-user';
import type { NoteType } from '@prisma/client';

export async function createNote(formData: FormData) {
  const user = await requireUser();

  const title = String(formData.get('title') ?? '').trim();
  const content = String(formData.get('content') ?? '').trim();
  const type = (String(formData.get('type') ?? 'NOTE') as NoteType) ?? 'NOTE';
  const projectId = String(formData.get('projectId') ?? '') || null;
  const location = String(formData.get('location') ?? '').trim() || null;
  const topicNamesRaw = String(formData.get('topics') ?? '');

  if (!title) throw new Error('Judul wajib diisi.');

  const topicNames = topicNamesRaw
    .split(',')
    .map((t) => t.trim())
    .filter(Boolean);

  const note = await prisma.note.create({
    data: {
      userId: user.id,
      title,
      content,
      type,
      projectId,
      spatiotemporalLocation: location,
      spatiotemporalTime: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }),
      interactions: { create: { type: 'CREATE', weight: 1.0 } },
    },
  });

  for (const name of topicNames) {
    const topic = await prisma.topic.upsert({
      where: { userId_name: { userId: user.id, name } },
      update: {},
      create: { userId: user.id, name },
    });
    await prisma.noteTopic.create({ data: { noteId: note.id, topicId: topic.id } });
  }

  await prisma.memoryScore.create({
    data: { noteId: note.id, memoryBuoyancy: 1, preservationValue: 0.3, folder: 'LAST_FOCUS' },
  });

  revalidatePath('/');
  revalidatePath('/notes');
  redirect(`/notes/${note.id}`);
}

export async function updateNote(noteId: string, formData: FormData) {
  const user = await requireUser();

  const title = String(formData.get('title') ?? '').trim();
  const content = String(formData.get('content') ?? '').trim();
  const quality = Number(formData.get('quality') ?? 0.5);
  const coverage = Number(formData.get('coverage') ?? 0.5);

  const existing = await prisma.note.findFirstOrThrow({ where: { id: noteId, userId: user.id } });

  await prisma.note.update({
    where: { id: noteId },
    data: {
      title,
      content,
      quality,
      coverage,
      userInvestment: Math.min(1, existing.userInvestment + 0.1),
      interactions: { create: { type: 'EDIT', weight: 0.8 } },
    },
  });

  revalidatePath(`/notes/${noteId}`);
  revalidatePath('/notes');
  revalidatePath('/');
}

export async function logNoteView(noteId: string) {
  const user = await requireUser();
  await prisma.note.findFirstOrThrow({ where: { id: noteId, userId: user.id } });
  await prisma.interaction.create({ data: { noteId, type: 'VIEW', weight: 0.2 } });
}

export async function deleteNote(noteId: string) {
  const user = await requireUser();
  await prisma.note.deleteMany({ where: { id: noteId, userId: user.id } });
  revalidatePath('/notes');
  revalidatePath('/');
  redirect('/notes');
}
</file>

